import java.util.*;

public class Main {
    public static void main(String[] args){
        int arr[]={4,7,6,9,10};
        int n=arr.length;
	int large = Integer.MIN_VALUE;
	int second_large = Integer.MIN_VALUE;
	int i;
	for (i =0;i< n;i++)
	{
		large = Math.max(large,arr[i]);
	}
	for (i = 0;i < n;i++)
	{
		if (arr[i] > second_large && arr[i] != large)
		{
			second_large = arr[i];
		}
	}

	System.out.println("Second smallest is "+second_large);
    }
}
